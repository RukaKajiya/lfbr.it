rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string &&
             id.size() > 0 &&
             id.size() <= 128 &&
             id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function validUser(data) {
      return data.keys().hasAll(['id', 'email', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly([
               'id', 'email', 'displayName',
               'travelProfile', 'profileUpdatedAt',
               'createdAt', 'updatedAt'
             ]) &&
             data.id == request.auth.uid &&
             isValidId(data.id) &&
             data.email is string &&
             data.email.size() <= 256 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('travelProfile' in data) || data.travelProfile is map) &&
             (!('profileUpdatedAt' in data) || data.profileUpdatedAt is timestamp) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function validTripStatus(status) {
      return status == 'draft' ||
             status == 'planned' ||
             status == 'in_progress' ||
             status == 'completed';
    }

    function validTrip(data) {
      return data.keys().hasAll([
               'id', 'ownerId', 'destinationId',
               'status', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'id', 'ownerId', 'destinationId',
               'title', 'score', 'profile', 'itinerary',
               'travelQuotes', 'isPublic', 'status',
               'createdAt', 'updatedAt'
             ]) &&
             isValidId(data.id) &&
             data.ownerId == request.auth.uid &&
             isValidId(data.ownerId) &&
             data.destinationId is string &&
             data.destinationId.size() > 0 &&
             data.destinationId.size() <= 64 &&
             (!('title' in data) || (data.title is string && data.title.size() <= 120)) &&
             (!('score' in data) || (data.score is number && data.score >= 0 && data.score <= 100)) &&
             (!('profile' in data) || data.profile is map) &&
             (!('itinerary' in data) || (data.itinerary is list && data.itinerary.size() <= 30)) &&
             (!('travelQuotes' in data) || data.travelQuotes is map) &&
             (!('isPublic' in data) || data.isPublic is bool) &&
             validTripStatus(data.status) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                    isValidId(userId) &&
                    validUser(request.resource.data) &&
                    request.resource.data.id == userId &&
                    request.resource.data.createdAt == request.time &&
                    request.resource.data.updatedAt == request.time;

      allow update: if isOwner(userId) &&
                    isValidId(userId) &&
                    validUser(request.resource.data) &&
                    request.resource.data.id == resource.data.id &&
                    request.resource.data.createdAt == resource.data.createdAt &&
                    request.resource.data.updatedAt == request.time &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'email', 'displayName',
                      'travelProfile', 'profileUpdatedAt',
                      'updatedAt'
                    ]);

      allow delete: if isOwner(userId) && isValidId(userId);
    }

    match /trips/{tripId} {
      allow get: if resource.data.isPublic == true ||
                    (isSignedIn() && resource.data.ownerId == request.auth.uid);

      allow list: if isSignedIn() &&
                     resource.data.ownerId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(tripId) &&
                       validTrip(request.resource.data) &&
                       request.resource.data.id == tripId &&
                       request.resource.data.ownerId == request.auth.uid &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time;

      allow update: if isSignedIn() &&
                       isValidId(tripId) &&
                       resource.data.ownerId == request.auth.uid &&
                       validTrip(request.resource.data) &&
                       request.resource.data.id == resource.data.id &&
                       request.resource.data.ownerId == resource.data.ownerId &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'title', 'score', 'profile', 'itinerary',
                         'travelQuotes', 'isPublic', 'status', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() &&
                       isValidId(tripId) &&
                       resource.data.ownerId == request.auth.uid;
    }


    function validWatchType(type) {
      return type == 'flight' || type == 'hotel';
    }

    function validAlertMode(mode) {
      return mode == 'new_low' ||
             mode == 'any_drop' ||
             mode == 'below' ||
             mode == 'drop_pct';
    }

    function validPriceWatch(data) {
      return data.keys().hasAll([
               'id', 'ownerId', 'type', 'label', 'query',
               'currency', 'initialPrice', 'lastPrice', 'bestPrice',
               'alertMode', 'enabled', 'live',
               'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'id', 'ownerId', 'tripId',
               'type', 'label', 'query', 'currency',
               'initialPrice', 'lastPrice', 'bestPrice',
               'alertMode', 'alertBelow', 'alertPercent',
               'enabled', 'live', 'source',
               'lastCheckedAt', 'lastError',
               'alertPending', 'alertReason', 'alertTriggeredAt',
               'createdAt', 'updatedAt'
             ]) &&
             isValidId(data.id) &&
             data.ownerId == request.auth.uid &&
             isValidId(data.ownerId) &&
             (!('tripId' in data) || (data.tripId is string && data.tripId.size() <= 128)) &&
             validWatchType(data.type) &&
             data.label is string &&
             data.label.size() > 0 &&
             data.label.size() <= 160 &&
             data.query is map &&
             data.currency is string &&
             data.currency.size() <= 8 &&
             data.initialPrice is number &&
             data.initialPrice > 0 &&
             data.lastPrice is number &&
             data.lastPrice > 0 &&
             data.bestPrice is number &&
             data.bestPrice > 0 &&
             validAlertMode(data.alertMode) &&
             (!('alertBelow' in data) || data.alertBelow is number) &&
             (!('alertPercent' in data) || data.alertPercent is number) &&
             data.enabled is bool &&
             data.live == true &&
             (!('source' in data) || data.source is string) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    match /priceWatches/{watchId} {
      allow get: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(watchId) &&
                       validPriceWatch(request.resource.data) &&
                       request.resource.data.id == watchId &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time;

      allow update: if isSignedIn() &&
                       resource.data.ownerId == request.auth.uid &&
                       request.resource.data.ownerId == resource.data.ownerId &&
                       request.resource.data.id == resource.data.id &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'label', 'alertMode', 'alertBelow',
                         'alertPercent', 'enabled', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      match /snapshots/{snapshotId} {
        allow read: if isSignedIn() &&
          get(/databases/$(database)/documents/priceWatches/$(watchId)).data.ownerId == request.auth.uid;
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
