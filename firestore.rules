rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'email', 'displayName', 'createdAt', 'updatedAt']) &&
             data.id is string && isValidId(data.id) && data.id == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidTrip(data) {
      return data.keys().hasAll(['id', 'ownerId', 'destinationId', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'ownerId', 'destinationId', 'title', 'score', 'profile', 'itinerary', 'isPublic', 'createdAt', 'updatedAt']) &&
             data.id is string && isValidId(data.id) &&
             data.ownerId is string && isValidId(data.ownerId) && data.ownerId == request.auth.uid &&
             data.destinationId is string && data.destinationId.size() <= 64 &&
             (!('title' in data) || (data.title is string && data.title.size() <= 120)) &&
             (!('score' in data) || data.score is number) &&
             (!('profile' in data) || data.profile is map) &&
             (!('itinerary' in data) || (data.itinerary is list && data.itinerary.size() <= 30)) &&
             (!('isPublic' in data) || data.isPublic is bool) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUser(incoming()) &&
                       incoming().id == userId &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time;
      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUser(incoming()) &&
                       incoming().id == existing().id &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    match /trips/{tripId} {
      allow get: if (resource.data.isPublic == true) || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || resource.data.isPublic == true);
      allow create: if isSignedIn() &&
                       isValidId(tripId) &&
                       isValidTrip(incoming()) &&
                       incoming().id == tripId &&
                       incoming().ownerId == request.auth.uid &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time;
      allow update: if isSignedIn() &&
                       isValidId(tripId) &&
                       isValidTrip(incoming()) &&
                       existing().ownerId == request.auth.uid &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().id == existing().id &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'score', 'profile', 'itinerary', 'isPublic', 'updatedAt']);
      allow delete: if isSignedIn() &&
                       isValidId(tripId) &&
                       existing().ownerId == request.auth.uid;
    }
  }
}
