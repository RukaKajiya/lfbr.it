# Non inserire credenziali reali in GitHub.
# Configurare questi valori nell'ambiente di AI Studio / Cloud Run e Firebase Functions.
AMADEUS_CLIENT_ID=your_client_id
AMADEUS_CLIENT_SECRET=your_client_secret

# Test API di default. Per produzione usare l'host previsto dal proprio contratto/provider.
AMADEUS_HOST=https://test.api.amadeus.com
