# Non inserire la chiave reale in GitHub.
# AI Studio / Cloud Run: salvare SERPAPI_KEY come variabile segreta lato server.
# Firebase Functions: preferire Secret Manager:
# firebase functions:secrets:set SERPAPI_KEY
SERPAPI_KEY=your_serpapi_key

# Localizzazione delle ricerche Google Flights / Google Hotels
SERPAPI_HL=it
SERPAPI_GL=it
SERPAPI_CURRENCY=EUR
